# ==============================================================================
# RecoverX Sentinel - Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit real .env files to version control.

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=razorpay_project
DB_USER=postgres
DB_PASSWORD=your_database_password

# Razorpay Test Mode Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key

# Advisory AI Analysis (Optional - Gemini / FreeLLMAPI)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=your_freellmapi_key
FREELLMAPI_MODEL=gemini-3.6-flash

# Backend Server Configuration (Production / Cloud Hosting)
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
