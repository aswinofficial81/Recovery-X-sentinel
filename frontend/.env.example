# ==============================================================================
# RecoverX Sentinel - Frontend Environment Template
# ==============================================================================

# Backend API Base URL (leave empty or set to http://127.0.0.1:8000 for local dev)
# For Vercel deployment, set this in Vercel Project Settings to your production backend URL:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: Razorpay Test Key ID for client checkout simulation (safe public key only)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
