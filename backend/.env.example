# ==============================================================================
# RecoverX Sentinel - Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recoverx_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Razorpay Test Mode Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key

# Advisory AI Analysis (Optional - Gemini / FreeLLMAPI)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=your_optional_api_key
FREELLMAPI_MODEL=gemini-3.6-flash
